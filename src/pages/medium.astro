---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediumCard from '../components/MediumCard.astro';
import { fetchMediumPosts } from '../lib/medium';

const posts = await fetchMediumPosts();
---

<BaseLayout 
  title="Medium Series & Stories | Morad Abaz" 
  description="Explore my latest series and technical articles published on Medium (@moradabaz), covering SQL hallucination prevention, CDC architecture, and LLM semantic layers."
>
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-medium" style="margin-bottom: 0.8rem;">Medium Channel</div>
      <h1>Medium <span class="gradient-text">Stories & Technical Series</span></h1>
      <p class="page-subtitle">
        Here you will find all my articles published on Medium. I write regularly about Semantic Layers, Postgres, LLM Evaluation, CDC Pipelines, and Stream Processing.
      </p>

      <div class="header-actions">
        <a 
          href="https://medium.com/@moradabaz" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary"
        >
          Follow @moradabaz on Medium
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="cards-grid">
      {posts.map(post => (
        <MediumCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 780px;
  }

  .page-header h1 {
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.8rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }
</style>
