  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.8rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--accent-indigo);
  }

  .pill-header {
    max-width: 720px;
    margin-bottom: 2rem;
  }

  .pill-header h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }

  .pill-lead {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 640px;
  }

  .pill-footer {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--bg-card);
  }

  .pill-footer h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .pill-footer p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.1rem;
    max-width: 600px;
  }

  .pill-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
</style>
