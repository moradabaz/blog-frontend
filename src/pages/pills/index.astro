---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
---

<BaseLayout
  title="Quizzes | Morad Abaz"
  description="One quiz per pill, across the Spark Pills, Semantic Layer Pills, and Streaming Pills series. Test what actually stuck."
>
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-purple" style="margin-bottom: 0.8rem;">26 Quizzes · 3 Series</div>
      <h1>Test What You've <span class="gradient-text-alt">Learned</span></h1>
      <p class="page-subtitle">
        Pick a series to see its quizzes. Each pill has one quiz that checks whether the
        reasoning actually stuck, not just whether you can recall a keyword.
      </p>
    </div>

    <div class="cards-grid">
      <SeriesCard
        title="Spark Pills Quizzes"
        description="10 quizzes, one per pill: MapReduce, the DAG, shuffle, joins, skew, caching, the Spark UI, Iceberg, and streaming."
        count={10}
        countLabel="quizzes"
        badgeLabel="Quiz Set"
        footerLabel="View quizzes →"
        href="/pills/spark-quizzes"
      />
      <SeriesCard
        title="Semantic Layer Pills Quizzes"
        description="6 quizzes, one per pill: zero context, column descriptions, business logic, routing, access control, and real errors."
        count={6}
        countLabel="quizzes"
        badgeLabel="Quiz Set"
        footerLabel="View quizzes →"
        href="/pills/semantic-layer-quizzes"
      />
      <SeriesCard
        title="Streaming Pills Quizzes"
        description="10 quizzes, one per pill: events vs messages, event time, logs vs queues, state, windows, late data, and streaming joins."
        count={10}
        countLabel="quizzes"
        badgeLabel="Quiz Set"
        footerLabel="View quizzes →"
        href="/pills/streaming-quizzes"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
    max-width: 780px;
  }

  .page-header h1 {
    margin-bottom: 0.6rem;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }

  @media (max-width: 640px) {
    .page-container {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
