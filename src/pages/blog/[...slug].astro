---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout 
  title={`${post.data.title} | Morad Abaz`} 
  description={post.data.description}
>
  <article class="article-container">
    <div class="container">
      <!-- Article Header -->
      <header class="article-header">
        <a href="/blog" class="back-link">
          ← Back to Articles
        </a>

        <div class="article-meta">
          <span class="badge badge-purple">{post.data.category}</span>
          <span class="date">{formattedDate}</span>
          <span class="author">By {post.data.author}</span>
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-lead">{post.data.description}</p>

        <div class="tags-container">
          {post.data.tags.map((tag: string) => (
            <span class="badge">{tag}</span>
          ))}
        </div>
      </header>

      <!-- Article Body -->
      <div class="glass-card article-body prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.8rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-blue);
  }

  .article-header {
    max-width: 820px;
    margin: 0 auto 3rem auto;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
    font-size: 0.88rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.2rem;
    line-height: 1.25;
  }

  .article-lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .article-body {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem;
  }

  @media (max-width: 768px) {
    .article-container {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }
    .article-body {
      padding: 1.25rem;
    }
    .article-meta {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .article-lead {
      font-size: 1.05rem;
    }
    .article-header {
      margin-bottom: 2rem;
    }
  }
</style>
