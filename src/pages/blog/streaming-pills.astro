---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidDiagram from '../../components/MermaidDiagram.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.category === 'Streaming Pills');

function pillNumber(slug: string): number {
  const match = slug.match(/streaming-pill-(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
}

const sortedPosts = posts.sort((a, b) => pillNumber(a.slug) - pillNumber(b.slug));

const seriesMap = `flowchart TD
    subgraph F["Foundations"]
        direction LR
        P0["0 · Batch = Special Case"] --> P1["1 · Events vs Messages"] --> P2["2 · Two Clocks"]
    end
    subgraph L["Log-Based Processing"]
        direction LR
        P3["3 · Topics vs Queues"] --> P4["4 · Micro-batching Fails"]
    end
    subgraph S["State & Time"]
        direction LR
        P5["5 · Stateful Engines"] --> P6["6 · Windows"] --> P7["7 · Late Events"]
    end
    subgraph D["Design Decisions"]
        direction LR
        P8["8 · Joins"] --> P9["9 · Three Questions"]
    end
    F --> L --> S --> D`;
---

<BaseLayout
  title="Streaming Pills Series | Morad Abaz"
  description="A 10-part series on streaming fundamentals, synthesized from Kleppmann's Designing Data-Intensive Applications and two production write-ups: events vs messages, event time, logs vs queues, state, windows, late data, and streaming joins."
>
  <div class="container page-container">
    <a href="/blog" class="back-link">← Back to Articles</a>

    <div class="page-header">
      <div class="badge badge-series" style="margin-bottom: 0.8rem;">Series · 10 parts</div>
      <h1>Streaming Pills <span class="gradient-text">Fundamentals</span></h1>
      <p class="page-subtitle">
        A series for data engineers who want to understand streaming from first principles, not
        as "batch, but faster." Synthesized from Martin Kleppmann's <em>Designing Data-Intensive
        Applications</em> and two production write-ups on stream processing. Each pill starts from
        a real question.
      </p>
    </div>

    <div class="series-map glass-card">
      <p class="series-map-label">Series map</p>
      <MermaidDiagram code={seriesMap} />
    </div>

    <ol class="pills-list">
      {sortedPosts.map((post, i) => (
        <li class="pill-item">
          <a href={`/blog/${post.slug}`} class="pill-link">
            <span class="pill-index">{String(i).padStart(2, '0')}</span>
            <div class="pill-body">
              <h3 class="pill-title">{post.data.title}</h3>
              <p class="pill-description">{post.data.description}</p>
              <div class="pill-tags">
                {post.data.tags.slice(0, 4).map((tag: string) => (
                  <span class="badge">{tag}</span>
                ))}
              </div>
            </div>
            <span class="pill-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.8rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-blue);
  }

  .badge-series {
    background: var(--accent-blue);
    color: #ffffff;
  }

  .page-header {
    margin-bottom: 2.25rem;
    max-width: 780px;
  }

  .page-header h1 {
    margin-bottom: 0.6rem;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .series-map {
    margin-bottom: 2.25rem;
    padding: 1.25rem 1.4rem;
    background: var(--bg-subtle);
  }

  .series-map-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 0.4rem;
  }

  .pills-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    list-style: none;
  }

  .pill-item {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .pill-item:hover {
    transform: translateY(-2px);
    border-color: var(--border-color-hover);
    box-shadow: var(--shadow-hover);
  }

  .pill-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.15rem 1.4rem;
    color: inherit;
  }

  .pill-link:hover {
    color: inherit;
  }

  .pill-index {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--accent-blue);
    width: 2.4rem;
    text-align: center;
  }

  .pill-body {
    flex-grow: 1;
    min-width: 0;
  }

  .pill-title {
    font-size: 1.02rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    line-height: 1.4;
  }

  .pill-description {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 0.6rem;
  }

  .pill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pill-arrow {
    flex-shrink: 0;
    color: var(--text-dim);
    font-size: 1.1rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .pill-item:hover .pill-arrow {
    color: var(--accent-blue);
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .pill-link {
      flex-wrap: wrap;
      gap: 0.6rem 1rem;
    }
    .pill-arrow {
      display: none;
    }
  }
</style>
