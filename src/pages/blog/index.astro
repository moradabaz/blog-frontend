---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title="Articles & Tutorials | Morad Abaz" 
  description="Technical articles, computer science tutorials, data science exercises, C language fundamentals, and software engineering notes by Morad Abaz."
>
  <div class="container page-container">
    <div class="page-header">
      <div class="badge badge-purple" style="margin-bottom: 0.8rem;">Articles Archive</div>
      <h1>Articles & <span class="gradient-text-alt">Code Tutorials</span></h1>
      <p class="page-subtitle">
        Explore articles on Data Science, Machine Learning models, C language syntax, and software development fundamentals.
      </p>
    </div>

    <div class="cards-grid">
      {sortedPosts.map(post => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 780px;
  }

  .page-header h1 {
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }
</style>
