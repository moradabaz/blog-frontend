---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediumCard from '../components/MediumCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { fetchMediumPosts } from '../lib/medium';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL;
const mediumPosts = await fetchMediumPosts();
const localPosts = await getCollection('blog');
const sortedLocalPosts = localPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge animate-fade-in">
        <span class="pulse-dot"></span>
        <span>Software Engineer & Data Writer</span>
      </div>

      <h1 class="hero-title animate-fade-in">
        Building Systems, Exploring Data & Sharing <span class="gradient-text">Engineering Insights</span>
      </h1>

      <p class="hero-subtitle animate-fade-in">
        Welcome to my personal blog! I write about Software Architecture, Machine Learning, C/Python internals, and deep-dive technical stories on <strong>Medium</strong>.
      </p>

      <div class="hero-ctas animate-fade-in">
        <a href="https://medium.com/@moradabaz" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Explore Medium Stories
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
        <a href={`${baseUrl}blog`.replace(/\/\//g, '/')} class="btn btn-secondary">
          Read Local Articles
        </a>
      </div>
    </div>
  </section>

  <!-- Medium Stories Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="badge badge-medium" style="margin-bottom: 0.6rem;">Medium Channel</div>
          <h2>Latest Stories on <span class="gradient-text">Medium</span></h2>
          <p class="section-subtitle">Synced automatically from my Medium feed (@moradabaz)</p>
        </div>
        <a href={`${baseUrl}medium`.replace(/\/\//g, '/')} class="btn btn-secondary btn-sm">View All Series →</a>
      </div>

      <div class="cards-grid">
        {mediumPosts.slice(0, 3).map(post => (
          <MediumCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Local Blog Posts Section -->
  <section class="section alt-bg">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="badge badge-purple" style="margin-bottom: 0.6rem;">Articles & Guides</div>
          <h2>Featured <span class="gradient-text-alt">Technical Posts</span></h2>
          <p class="section-subtitle">Data Science exercises, C fundamentals & tutorials</p>
        </div>
        <a href={`${baseUrl}blog`.replace(/\/\//g, '/')} class="btn btn-secondary btn-sm">Explore All Articles →</a>
      </div>

      <div class="cards-grid">
        {sortedLocalPosts.slice(0, 3).map(post => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Bio & Quick Links Banner -->
  <section class="section">
    <div class="container">
      <div class="glass-card bio-banner">
        <div class="bio-content">
          <h3>Hi, I'm <span class="gradient-text">Morad</span></h3>
          <p>
            I studied Computer Science at the University of Murcia (Spain) and work as a Software Engineer. I love crafting high-performance systems, delving into LLMs, data engineering pipelines, and helping fellow developers grow.
          </p>
          <div class="bio-links">
            <a href={`${baseUrl}about`.replace(/\/\//g, '/')} class="btn btn-secondary btn-sm">Read Full Story</a>
            <a href="https://github.com/moradisten" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">GitHub Profile</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding: 6rem 0 4rem 0;
    text-align: center;
  }

  .hero-container {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.2rem;
    border-radius: var(--radius-full);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--accent-cyan);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.8rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  .hero-title {
    margin-bottom: 1.4rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2.2rem;
    max-width: 720px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  /* Section Styling */
  .section {
    padding: 4rem 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 0.4rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.8rem;
  }

  .bio-banner {
    padding: 3rem;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.6) 0%, rgba(15, 23, 42, 0.9) 100%);
  }

  .bio-content h3 {
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  .bio-content p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 780px;
    margin-bottom: 1.6rem;
    line-height: 1.7;
  }

  .bio-links {
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .hero-section {
      padding: 4rem 0 2rem 0;
    }
  }
</style>
