---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediumCard from '../components/MediumCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { fetchMediumPosts } from '../lib/medium';
import { getCollection } from 'astro:content';

const mediumPosts = await fetchMediumPosts();
const localPosts = await getCollection('blog');
const sortedLocalPosts = localPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>Data Engineer • Lakehouse Architecture</span>
      </div>

      <h1 class="hero-title">
        Building Data Lakehouses & Writing About <span class="gradient-text">Spark, Iceberg & dbt</span>
      </h1>

      <p class="hero-subtitle">
        I'm a Data Engineer working with <strong>Spark</strong>, <strong>Apache Iceberg</strong>, and <strong>dbt</strong> on <strong>AWS</strong>. I maintain a SaaS production Lakehouse platform with dozens of Glue jobs and write about real-world engineering problems on Medium.
      </p>

      <div class="hero-ctas">
        <a href="https://medium.com/@moradabaz" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Read Medium Stories
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/morad-abbou-azaz/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>

  <!-- Medium Stories Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="badge badge-medium" style="margin-bottom: 0.4rem;">Medium Feed</div>
          <h2>Latest Stories on <span class="gradient-text">Medium</span></h2>
          <p class="section-subtitle">Real-world production engineering challenges and Lakehouse insights</p>
        </div>
        <a href="/medium" class="btn btn-secondary btn-sm">View All Stories →</a>
      </div>

      <div class="cards-grid">
        {mediumPosts.slice(0, 3).map(post => (
          <MediumCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Local Blog Posts Section -->
  <section class="section alt-bg">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="badge badge-purple" style="margin-bottom: 0.4rem;">Archive & Code</div>
          <h2>Featured <span class="gradient-text-alt">Technical Notes</span></h2>
          <p class="section-subtitle">Data Science exercises, ML algorithms & C programming notes</p>
        </div>
        <a href="/blog" class="btn btn-secondary btn-sm">Browse Archive →</a>
      </div>

      <div class="cards-grid">
        {sortedLocalPosts.slice(0, 3).map(post => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Bio & Quick Links Banner -->
  <section class="section">
    <div class="container">
      <div class="glass-card bio-banner">
        <div class="bio-content">
          <h3>About <span class="gradient-text">Morad</span></h3>
          <p>
            I'm a Data Engineer working with Spark, Iceberg, and dbt on AWS. As the sole DE at a SaaS company, I maintain a Lakehouse platform with dozens of AWS Glue jobs. Most of my day-to-day is diagnosing performance issues in Spark pipelines and understanding how Apache Iceberg behaves under production conditions.
          </p>
          <div class="bio-links">
            <a href="/about" class="btn btn-secondary btn-sm">Read Full About</a>
            <a href="https://www.linkedin.com/in/morad-abbou-azaz/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">LinkedIn Profile</a>
            <a href="https://github.com/moradisten" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding: 4.5rem 0 3rem 0;
    text-align: center;
  }

  .hero-container {
    max-width: 780px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-blue);
  }

  .hero-title {
    margin-bottom: 1.1rem;
    font-weight: 700;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.8rem;
    max-width: 680px;
    font-weight: 400;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  /* Section Styling */
  .section {
    padding: 3rem 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.4rem;
  }

  .bio-banner {
    padding: 2.25rem;
    background: #ffffff;
  }

  .bio-content h3 {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
  }

  .bio-content p {
    color: var(--text-muted);
    font-size: 0.98rem;
    max-width: 740px;
    margin-bottom: 1.4rem;
    line-height: 1.7;
  }

  .bio-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .hero-section {
      padding: 3rem 0 1.5rem 0;
    }
  }
</style>
