---
const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-info">
      <p class="footer-logo">Morad Abaz</p>
      <p class="footer-desc">Software Engineer & Data Tech Writer based in Murcia, Spain.</p>
    </div>

    <div class="footer-links">
      <div class="link-group">
        <h4>Navigation</h4>
        <a href={baseUrl}>Home</a>
        <a href={`${baseUrl}medium`.replace(/\/\//g, '/')}>Medium Series</a>
        <a href={`${baseUrl}blog`.replace(/\/\//g, '/')}>Articles & Code</a>
        <a href={`${baseUrl}about`.replace(/\/\//g, '/')}>About Me</a>
      </div>

      <div class="link-group">
        <h4>Connect</h4>
        <a href="https://medium.com/@moradabaz" target="_blank" rel="noopener noreferrer">Medium (@moradabaz)</a>
        <a href="https://github.com/moradisten" target="_blank" rel="noopener noreferrer">GitHub (@moradisten)</a>
        <a href="https://www.instagram.com/random.coding/" target="_blank" rel="noopener noreferrer">Instagram (@random.coding)</a>
        <a href="mailto:moradabaz@gmail.com">Email Me</a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} Morad Abaz. Hosted on GitHub Pages.</p>
  </div>
</footer>

<style>
  .footer {
    background: rgba(11, 15, 25, 0.95);
    border-top: 1px solid var(--border-color);
    padding: 4rem 0 2rem 0;
    margin-top: 6rem;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text-main);
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 360px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .link-group h4 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  .link-group a {
    display: block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.6rem;
    transition: color 0.2s ease;
  }

  .link-group a:hover {
    color: var(--accent-cyan);
  }

  .footer-bottom {
    padding-top: 2rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
