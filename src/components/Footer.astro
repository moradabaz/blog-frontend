---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-info">
      <p class="footer-logo">Morad Abaz</p>
      <p class="footer-desc">Data Engineer working with Spark, Iceberg, dbt, and AWS Glue Lakehouses.</p>
    </div>

    <div class="footer-links">
      <div class="link-group">
        <h4>Navigation</h4>
        <a href="/">Home</a>
        <a href="/medium">Medium Series</a>
        <a href="/blog">Articles & Code</a>
        <a href="/about">About Me</a>
      </div>

      <div class="link-group">
        <h4>Connect</h4>
        <a href="https://www.linkedin.com/in/morad-abbou-azaz/" target="_blank" rel="noopener noreferrer">LinkedIn (Morad Abbou Azaz)</a>
        <a href="https://medium.com/@moradabaz" target="_blank" rel="noopener noreferrer">Medium (@moradabaz)</a>
        <a href="https://github.com/moradisten" target="_blank" rel="noopener noreferrer">GitHub (@moradisten)</a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} Morad Abaz. Hosted on GitHub Pages.</p>
  </div>
</footer>

<style>
  .footer {
    background: #f1f5f9;
    border-top: 1px solid var(--border-color);
    padding: 3rem 0 2rem 0;
    margin-top: 4rem;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--text-main);
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 340px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .link-group h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .link-group a {
    display: block;
    color: var(--text-muted);
    font-size: 0.86rem;
    margin-bottom: 0.45rem;
    transition: color 0.15s ease;
  }

  .link-group a:hover {
    color: var(--accent-blue);
  }

  .footer-bottom {
    padding-top: 1.5rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
