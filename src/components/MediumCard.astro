---
import type { MediumPost } from '../lib/medium';

interface Props {
  post: MediumPost;
}

const { post } = Astro.props;
---

<article class="glass-card medium-card">
  <div class="card-content">
    <div class="card-header">
      <div class="card-badges">
        <span class="badge badge-medium">
          Medium
        </span>
        {post.categories.slice(0, 2).map((cat: string) => (
          <span class="badge">{cat}</span>
        ))}
      </div>
      <span class="card-date">{post.formattedDate}</span>
    </div>

    <h3 class="card-title">
      <a href={post.link} target="_blank" rel="noopener noreferrer">
        {post.title}
      </a>
    </h3>

    <p class="card-snippet">{post.snippet}</p>

    <div class="card-footer">
      <a 
        href={post.link} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="read-more"
      >
        Read story on Medium →
      </a>
    </div>
  </div>
</article>

<style>
  .medium-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-content {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-date {
    font-size: 0.78rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .card-title {
    margin-bottom: 0.65rem;
    font-size: 1.12rem;
    line-height: 1.4;
    font-weight: 600;
  }

  .card-title a {
    color: var(--text-main);
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent-blue);
  }

  .card-snippet {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-color);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.84rem;
    font-weight: 500;
    color: #b45309;
    transition: color 0.15s ease;
  }

  .read-more:hover {
    color: #92400e;
  }
</style>
