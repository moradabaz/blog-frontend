---
/**
 * Quiz.astro — Componente interactivo de quiz para las pills de Spark.
 * Vanilla JS, sin dependencias externas.
 *
 * Uso:
 *   import Quiz from '../components/Quiz.astro';
 *   <Quiz title="Quiz: MapReduce" questions={[
 *     { question: "...", options: ["A","B","C","D"], correct: 2, explanation: "..." }
 *   ]} />
 */

interface Question {
  question: string;
  options: string[];
  correct: number;
  explanation: string;
}

interface Props {
  title?: string;
  questions: Question[];
}

const { title = "Quiz", questions } = Astro.props;
const quizId = `quiz-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="quiz-wrapper" id={quizId} data-questions={JSON.stringify(questions)}>
  <!-- Header -->
  <div class="quiz-header">
    <div class="quiz-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      Quiz
    </div>
    <h3 class="quiz-title">{title}</h3>
    <div class="quiz-progress">
      <span class="quiz-progress-text">Question <span class="quiz-current">1</span> of {questions.length}</span>
      <div class="quiz-progress-bar">
        <div class="quiz-progress-fill" style="width: 0%"></div>
      </div>
    </div>
  </div>

  <!-- Question area -->
  <div class="quiz-body">
    <p class="quiz-question"></p>
    <div class="quiz-options"></div>
    <div class="quiz-feedback" hidden>
      <div class="quiz-feedback-icon"></div>
      <p class="quiz-feedback-text"></p>
    </div>
  </div>

  <!-- Footer -->
  <div class="quiz-footer">
    <button class="quiz-btn quiz-btn-next" hidden>
      Next
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </button>
  </div>

  <!-- Results (hidden until end) -->
  <div class="quiz-results" hidden>
    <div class="quiz-results-icon"></div>
    <h3 class="quiz-results-title"></h3>
    <p class="quiz-results-score"></p>
    <div class="quiz-results-breakdown"></div>
    <button class="quiz-btn quiz-btn-retry">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="23 4 23 10 17 10"/>
        <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
      </svg>
      Retry quiz
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('.quiz-wrapper').forEach(wrapper => {
    const questions: { question: string; options: string[]; correct: number; explanation: string }[] =
      JSON.parse(wrapper.getAttribute('data-questions') || '[]');

    let current = 0;
    let score = 0;
    let answered = false;
    const answers: (boolean)[] = [];

    // DOM refs
    const body = wrapper.querySelector('.quiz-body') as HTMLElement;
    const questionEl = wrapper.querySelector('.quiz-question') as HTMLElement;
    const optionsEl = wrapper.querySelector('.quiz-options') as HTMLElement;
    const feedbackEl = wrapper.querySelector('.quiz-feedback') as HTMLElement;
    const feedbackIcon = wrapper.querySelector('.quiz-feedback-icon') as HTMLElement;
    const feedbackText = wrapper.querySelector('.quiz-feedback-text') as HTMLElement;
    const nextBtn = wrapper.querySelector('.quiz-btn-next') as HTMLButtonElement;
    const progressText = wrapper.querySelector('.quiz-current') as HTMLElement;
    const progressFill = wrapper.querySelector('.quiz-progress-fill') as HTMLElement;
    const resultsEl = wrapper.querySelector('.quiz-results') as HTMLElement;
    const resultsIcon = wrapper.querySelector('.quiz-results-icon') as HTMLElement;
    const resultsTitle = wrapper.querySelector('.quiz-results-title') as HTMLElement;
    const resultsScore = wrapper.querySelector('.quiz-results-score') as HTMLElement;
    const resultsBreakdown = wrapper.querySelector('.quiz-results-breakdown') as HTMLElement;
    const retryBtn = wrapper.querySelector('.quiz-btn-retry') as HTMLButtonElement;
    const footer = wrapper.querySelector('.quiz-footer') as HTMLElement;

    function render() {
      const q = questions[current];
      answered = false;

      // Update progress
      progressText.textContent = String(current + 1);
      progressFill.style.width = `${((current) / questions.length) * 100}%`;

      // Question
      questionEl.textContent = q.question;

      // Options
      optionsEl.innerHTML = '';
      q.options.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-option';
        btn.innerHTML = `<span class="quiz-option-letter">${String.fromCharCode(65 + i)}</span><span class="quiz-option-text">${opt}</span>`;
        btn.addEventListener('click', () => selectOption(i));
        optionsEl.appendChild(btn);
      });

      // Hide feedback & next
      feedbackEl.hidden = true;
      nextBtn.hidden = true;
      body.hidden = false;
      footer.hidden = false;
      resultsEl.hidden = true;
    }

    function selectOption(index: number) {
      if (answered) return;
      answered = true;

      const q = questions[current];
      const isCorrect = index === q.correct;
      if (isCorrect) score++;
      answers.push(isCorrect);

      // Style options
      const buttons = optionsEl.querySelectorAll('.quiz-option');
      buttons.forEach((btn, i) => {
        const el = btn as HTMLElement;
        el.style.pointerEvents = 'none';
        if (i === q.correct) {
          el.classList.add('correct');
        } else if (i === index && !isCorrect) {
          el.classList.add('incorrect');
        } else {
          el.classList.add('dimmed');
        }
      });

      // Feedback
      feedbackEl.hidden = false;
      feedbackEl.className = `quiz-feedback ${isCorrect ? 'feedback-correct' : 'feedback-incorrect'}`;
      feedbackIcon.textContent = isCorrect ? '✓' : '✗';
      feedbackText.textContent = q.explanation;

      // Show next or finish
      nextBtn.hidden = false;
      nextBtn.textContent = current < questions.length - 1 ? '' : '';
      nextBtn.innerHTML = current < questions.length - 1
        ? 'Next <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>'
        : 'See results';
    }

    function showResults() {
      body.hidden = true;
      footer.hidden = true;
      resultsEl.hidden = false;
      progressFill.style.width = '100%';

      const pct = Math.round((score / questions.length) * 100);
      let emoji = '';
      let msg = '';

      if (pct === 100) { emoji = '🏆'; msg = 'Perfect! You nailed this topic.'; }
      else if (pct >= 70) { emoji = '💪'; msg = 'Nice work! You have a solid foundation.'; }
      else if (pct >= 40) { emoji = '📖'; msg = 'Getting there. Re-read the pill to solidify the concepts.'; }
      else { emoji = '🔄'; msg = 'Worth going through this pill again carefully.'; }

      resultsIcon.textContent = emoji;
      resultsTitle.textContent = msg;
      resultsScore.innerHTML = `<strong>${score}</strong> de <strong>${questions.length}</strong> correctas (${pct}%)`;

      // Breakdown
      resultsBreakdown.innerHTML = '';
      questions.forEach((q, i) => {
        const row = document.createElement('div');
        row.className = `quiz-breakdown-row ${answers[i] ? 'row-correct' : 'row-incorrect'}`;
        row.innerHTML = `<span class="breakdown-icon">${answers[i] ? '✓' : '✗'}</span><span class="breakdown-text">${q.question}</span>`;
        resultsBreakdown.appendChild(row);
      });
    }

    nextBtn.addEventListener('click', () => {
      if (current < questions.length - 1) {
        current++;
        render();
      } else {
        showResults();
      }
    });

    retryBtn.addEventListener('click', () => {
      current = 0;
      score = 0;
      answers.length = 0;
      render();
    });

    // Init
    render();
  });
</script>

<style>
  .quiz-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    margin: 2rem 0;
  }

  /* Header */
  .quiz-header {
    padding: 1.5rem 1.75rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-subtle);
  }

  .quiz-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 500;
    background: #e0e7ff;
    color: #4338ca;
    margin-bottom: 0.6rem;
  }

  .quiz-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.85rem;
  }

  .quiz-progress-text {
    font-size: 0.82rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    display: block;
    margin-bottom: 0.4rem;
  }

  .quiz-progress-bar {
    height: 4px;
    background: var(--border-color);
    border-radius: 2px;
    overflow: hidden;
  }

  .quiz-progress-fill {
    height: 100%;
    background: var(--accent-indigo);
    border-radius: 2px;
    transition: width 0.4s ease;
  }

  /* Body */
  .quiz-body {
    padding: 1.75rem;
  }

  .quiz-question {
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Options */
  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--bg-card);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-main);
    transition: all 0.15s ease;
    line-height: 1.5;
  }

  .quiz-option:hover {
    border-color: var(--accent-indigo);
    background: #f5f3ff;
  }

  .quiz-option-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    border-radius: 6px;
    background: var(--bg-subtle);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .quiz-option-text {
    flex: 1;
  }

  .quiz-option.correct {
    border-color: #059669;
    background: #ecfdf5;
  }
  .quiz-option.correct .quiz-option-letter {
    background: #059669;
    color: #fff;
  }

  .quiz-option.incorrect {
    border-color: #dc2626;
    background: #fef2f2;
  }
  .quiz-option.incorrect .quiz-option-letter {
    background: #dc2626;
    color: #fff;
  }

  .quiz-option.dimmed {
    opacity: 0.45;
  }

  /* Feedback */
  .quiz-feedback {
    margin-top: 1.1rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    line-height: 1.6;
  }

  .quiz-feedback-icon {
    font-weight: 700;
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .quiz-feedback-text {
    font-size: 0.92rem;
    color: var(--text-main);
  }

  .feedback-correct {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
  }
  .feedback-correct .quiz-feedback-icon { color: #059669; }

  .feedback-incorrect {
    background: #fef2f2;
    border: 1px solid #fecaca;
  }
  .feedback-incorrect .quiz-feedback-icon { color: #dc2626; }

  /* Footer */
  .quiz-footer {
    padding: 0 1.75rem 1.5rem;
    display: flex;
    justify-content: flex-end;
  }

  .quiz-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    border: none;
    transition: all 0.15s ease;
  }

  .quiz-btn-next {
    background: var(--accent-indigo);
    color: #fff;
  }
  .quiz-btn-next:hover { background: #4338ca; }

  /* Results */
  .quiz-results {
    padding: 2.5rem 1.75rem;
    text-align: center;
  }

  .quiz-results-icon {
    font-size: 2.75rem;
    margin-bottom: 0.75rem;
  }

  .quiz-results-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .quiz-results-score {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .quiz-results-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
    max-width: 560px;
    margin: 0 auto 1.5rem;
  }

  .quiz-breakdown-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .breakdown-icon {
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .breakdown-text {
    color: var(--text-main);
  }

  .row-correct {
    background: #f0fdf4;
  }
  .row-correct .breakdown-icon { color: #059669; }

  .row-incorrect {
    background: #fef2f2;
  }
  .row-incorrect .breakdown-icon { color: #dc2626; }

  .quiz-btn-retry {
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    margin-top: 0.5rem;
  }
  .quiz-btn-retry:hover {
    background: var(--bg-subtle);
    border-color: var(--border-color-hover);
  }

  @media (max-width: 640px) {
    .quiz-header, .quiz-body, .quiz-footer, .quiz-results {
      padding-left: 1.15rem;
      padding-right: 1.15rem;
    }
  }
</style>
