---
const baseUrl = import.meta.env.BASE_URL;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Medium Series', href: '/medium' },
  { name: 'Articles & Code', href: '/blog' },
  { name: 'About', href: '/about' }
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="logo">
      <span class="logo-symbol">&lt;/&gt;</span>
      <span class="logo-text">Mora.d<span class="gradient-text">ata</span></span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav" id="desktopNav">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a 
            href={link.href} 
            class:list={['nav-link', { active: isActive }]}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <a 
        href="https://www.linkedin.com/in/morad-abbou-azaz/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-secondary btn-sm"
        title="LinkedIn Profile"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.4 1.4 0 1 0 1.4 1.4 1.4 1.4 0 0 0-1.4-1.4z"/>
        </svg>
        <span>LinkedIn</span>
      </a>

      <a 
        href="https://medium.com/@moradabaz" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-secondary btn-sm"
        title="Medium Profile"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
        </svg>
        <span>Medium</span>
      </a>
    </div>

    <!-- Hamburger Button (mobile only) -->
    <button
      class="hamburger"
      id="hamburgerBtn"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
    </button>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <nav class="mobile-nav">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={['mobile-nav-link', { active: isActive }]}
          >
            {link.name}
          </a>
        );
      })}
    </nav>
    <div class="mobile-social">
      <a href="https://www.linkedin.com/in/morad-abbou-azaz/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.4 1.4 0 1 0 1.4 1.4 1.4 1.4 0 0 0-1.4-1.4z"/>
        </svg>
        LinkedIn
      </a>
      <a href="https://medium.com/@moradabaz" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
        </svg>
        Medium
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('hamburgerBtn');
  const menu = document.getElementById('mobileMenu');

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    btn.classList.toggle('open', !isOpen);
    menu?.classList.toggle('open', !isOpen);
    menu?.setAttribute('aria-hidden', String(isOpen));
  });

  // Close menu when a nav link is clicked
  menu?.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      btn?.classList.remove('open');
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 250, 252, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    padding: 0.85rem 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    text-decoration: none;
    z-index: 110;
  }

  .logo-symbol {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  /* Desktop nav */
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 400;
    padding: 0.25rem 0.1rem;
    position: relative;
    transition: color 0.15s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-main);
    font-weight: 500;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent-blue);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-sm {
    padding: 0.35rem 0.75rem;
    font-size: 0.82rem;
  }

  /* Hamburger button — hidden on desktop */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 110;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  .hamburger:hover {
    background: var(--bg-subtle);
  }

  .ham-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-main);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  /* Animated X when open */
  .hamburger.open .ham-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.open .ham-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.open .ham-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu drawer */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(248, 250, 252, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    padding: 1.25rem 0;
    transform: translateY(-8px);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 0 1.5rem;
    margin-bottom: 1rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
    transition: color 0.15s ease;
  }

  .mobile-nav-link:last-child {
    border-bottom: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--accent-blue);
  }

  .mobile-social {
    display: flex;
    gap: 0.6rem;
    padding: 0.5rem 1.5rem 0;
  }

  /* Responsive breakpoints */
  @media (max-width: 768px) {
    .nav,
    .header-actions {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (min-width: 769px) {
    .hamburger,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
