.vs-button
  /*
  * Colores del componente con variables css
  */
  --vs-color: vs-var('primary')
  --vs-text-color: vs-var('color')

  border-radius: $vs-button-radius
  background: transparent
  padding: $vs-button-padding-y $vs-button-padding-x
  transition: $vs-button-transition
  position relative
  display: block
  border 2px solid vs-color('color')
  &:disabled
    opacity .5 !important
    pointer-events: none
    user-select none
  &:active
    opacity .8
  > span
    position relative
    display: block
    pointer-events: none
    transition: $vs-button-transition
    color vs-color('text-color', 1)
  &:hover
    background vs-color('color',1)
    span
      color rgb(255,255,255)
  &__active
    background vs-color('color')

  /*
  __Size
  */
  &--xlarge
    padding: $vs-button-padding-y * 1.4 $vs-button-padding-x * 1.4
    font-size: $vs-button-font-size * 1.3
  &--large
    padding: $vs-button-padding-y * 1.15 $vs-button-padding-x * 1.15
    font-size: $vs-button-font-size * 1.1
  &--small
    padding: ($vs-button-padding-y / 1.4) ($vs-button-padding-x / 1.4)
    font-size: ($vs-button-font-size / 1.3)
  &--mini
    padding: ($vs-button-padding-y / 1.8) ($vs-button-padding-x / 1.8)
    font-size: ($vs-button-font-size / 1.6)
    font-weight: bold


