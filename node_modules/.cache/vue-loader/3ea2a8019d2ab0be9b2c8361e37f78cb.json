ame: entry.id})\" >\n              <b-row>\n                <div class=\"col-md-4\" style=\"max-height: 200px\">\n                  <img v-bind:src=\"getImage(entry.image)\" style=\"height: 100px; width: 100%\">\n                </div>\n\n                <div class=\"col-md-8\" >\n                  <div class=\"card-body\">\n                    <h5 class=\"card-title\">{{entry.title}}</h5>\n                    <p class=\"card-text\">{{entry.description}}</p>\n                    <p class=\"card-text\"><small class=\"text-muted\">Last updated 3 mins ago</small></p>\n                  </div>\n                </div>\n              </b-row>\n            </div>\n\n\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport BLOGENTRIES from '@/statics/data/blogs.json'\n\nexport default {\n  name: 'home',\n\n  computed: {\n    entries() {\n      console.log(BLOGENTRIES)\n      return BLOGENTRIES\n    },\n    subforlders() {\n      return {\n        sections: [\n          \"Posts\",\n          \"Basic Courses and Exercises\"\n        ]\n      }\n    }\n  },\n  methods: {\n    getImage(type) {\n      switch (type) {\n        case \"education\":\n          return require(\"../assets/img/blogimages/education.png\");\n        case \"pills\":\n          return require(\"../assets/img/blogimages/pills.png\");\n        case \"projects\":\n          return require(\"../assets/img/blogimages/projects.png\");\n        default:\n          return require(\"../assets/img/blogimages/research.jpg\");\n      }\n    }\n  }\n}\n</script>\n<style lang=\"scss\" scoped>\n.center {\n  text-align: center;\n}\n.headline {\n  text-transform: uppercase;\n  margin: 4rem auto;\n  font-size: 4rem;\n}\nimg {\n  display: block;\n  margin: 0 auto;\n  width: 150px;\n}\n\nh2 {\n  color: #11100e;\n  text-transform: capitalize;\n  margin-bottom: 2rem;\n  font-family:  sans-serif;\n  font-weight: 100;\n}\n\nh3 {\n  //color: #0da766;\n  color: #27dc7e;\n  margin-botto