r />\n                  <input\n                    id=\"n_trees\"\n                    v-model=\"form.n_trees\"\n                    type=\"number\"\n                    class=\"validate\"\n                  />\n                </div>\n\n                <div class=\"input-field col s4\">\n                  <label ><b>Number of Candidates </b></label>\n                  <br />\n                  <input\n                    id=\"n_candidates\"\n                    v-model=\"form.candidates\"\n                    type=\"number\"\n                    class=\"validate\"\n                  />\n                </div>\n              </v-row>\n\n              <b-row v-else>\n                <div class=\"input-field col s4\">\n                  <label><b>Number of Neighbours</b></label>\n                  <br />\n                  <input\n                    id=\"n_neighbours\"\n                    v-model=\"form.neighbours\"\n                    type=\"number\"\n                    class=\"validate\"\n                  />\n                </div>\n\n                <div class=\"input-field col s4\">\n                  <label for=\"window_size\"><b>Window Size </b></label>\n                  <br />\n\n                  <input\n                    id=\"window_size\"\n                    v-model=\"form.window_size\"\n                    type=\"number\"\n                    step=\"any\"\n                    class=\"validate\"\n                  />\n                </div>\n                <div class=\"input-field col s4\">\n                  <label for=\"v_value\"><b>Threshold Value (V) </b></label>\n                  <br />\n                  <input\n                    id=\"v_value\"\n                    v-model=\"form.v_value\"\n                    type=\"number\"\n                    step=\"step\"\n                    class=\"validate\"\n                  />\n                </div>\n              </b-row>\n\n              <br />\n              <b-button\n                type=