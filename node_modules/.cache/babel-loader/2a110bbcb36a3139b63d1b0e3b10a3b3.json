{"remainingRequest":"/Users/morad/blog-frontend/node_modules/babel-loader/lib/index.js!/Users/morad/blog-frontend/node_modules/cache-loader/dist/cjs.js??ref--0-0!/Users/morad/blog-frontend/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/morad/blog-frontend/src/views/HomeBlog.vue?vue&type=script&lang=js&","dependencies":[{"path":"/Users/morad/blog-frontend/src/views/HomeBlog.vue","mtime":1620997937951},{"path":"/Users/morad/blog-frontend/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/morad/blog-frontend/node_modules/babel-loader/lib/index.js","mtime":315532800000},{"path":"/Users/morad/blog-frontend/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/morad/blog-frontend/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":["//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport BLOGENTRIES from '@/statics/data/blogs.json';\nexport default {\n  name: 'home',\n  computed: {\n    entries: function entries() {\n      console.log(BLOGENTRIES);\n      return BLOGENTRIES;\n    },\n    subforlders: function subforlders() {\n      return {\n        sections: [\"Posts\", \"Basic Courses and Exercises\"]\n      };\n    }\n  },\n  methods: {\n    getImage: function getImage(type) {\n      switch (type) {\n        case \"education\":\n          return require(\"../assets/img/blogimages/education.png\");\n\n        case \"pills\":\n          return require(\"../assets/img/blogimages/pills.png\");\n\n        case \"projects\":\n          return require(\"../assets/img/blogimages/projects.png\");\n\n        default:\n          return require(\"../assets/img/blogimages/research.jpg\");\n      }\n    }\n  }\n};",{"version":3,"sources":["HomeBlog.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAiDA,OAAA,WAAA,MAAA,2BAAA;AAEA,eAAA;AACA,EAAA,IAAA,EAAA,MADA;AAGA,EAAA,QAAA,EAAA;AACA,IAAA,OADA,qBACA;AACA,MAAA,OAAA,CAAA,GAAA,CAAA,WAAA;AACA,aAAA,WAAA;AACA,KAJA;AAKA,IAAA,WALA,yBAKA;AACA,aAAA;AACA,QAAA,QAAA,EAAA,CACA,OADA,EAEA,6BAFA;AADA,OAAA;AAMA;AAZA,GAHA;AAiBA,EAAA,OAAA,EAAA;AACA,IAAA,QADA,oBACA,IADA,EACA;AACA,cAAA,IAAA;AACA,aAAA,WAAA;AACA,iBAAA,OAAA,0CAAA;;AACA,aAAA,OAAA;AACA,iBAAA,OAAA,sCAAA;;AACA,aAAA,UAAA;AACA,iBAAA,OAAA,yCAAA;;AACA;AACA,iBAAA,OAAA,yCAAA;AARA;AAUA;AAZA;AAjBA,CAAA","sourcesContent":["<template>\n  <div class=\"home\">\n    <h1 class=\"headline center\">Welcome to my Blog</h1>\n    <img alt=\"Vue logo\" src=\"../assets/avatar.png\">\n    <div class=\"sections\">\n      <div v-for=\"(section, index) in Object.keys(entries)\" :key=\"index\" class=\"group\">\n        <h2 class=\"center\">{{subforlders.sections[index]}}</h2>\n        <div class=\"section\" v-for=\"entry in entries[section]\" :key=\"entry.id\">\n          <div class=\"entry\">\n           <!--<b-card\n                style=\"cursor: pointer;\"\n                :img-src=\"getImage(entry.image)\"\n                img-left\n                tag=\"article\"\n                class=\"mb-2\"\n            >\n              <b-card-title style=\"color: #0da766\"  @click=\"$router.push({name: entry.id})\">{{entry.title}}</b-card-title>\n              <b-card-text>\n                {{entry.description}}\n              </b-card-text>\n              <b-button variant=\"primary\" @click=\"$router.push({name: entry.id})\">Read the post</b-button>\n            </b-card> -->\n\n\n            <div class=\"card mb-3\" style=\"cursor: pointer;\" @click=\"$router.push({name: entry.id})\" >\n              <b-row>\n                <div class=\"col-md-4\" style=\"max-height: 200px\">\n                  <img v-bind:src=\"getImage(entry.image)\" style=\"height: 100px; width: 100%\">\n                </div>\n\n                <div class=\"col-md-8\" >\n                  <div class=\"card-body\">\n                    <h5 class=\"card-title\">{{entry.title}}</h5>\n                    <p class=\"card-text\">{{entry.description}}</p>\n                    <p class=\"card-text\"><small class=\"text-muted\">Last updated 3 mins ago</small></p>\n                  </div>\n                </div>\n              </b-row>\n            </div>\n\n\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport BLOGENTRIES from '@/statics/data/blogs.json'\n\nexport default {\n  name: 'home',\n\n  computed: {\n    entries() {\n      console.log(BLOGENTRIES)\n      return BLOGENTRIES\n    },\n    subforlders() {\n      return {\n        sections: [\n          \"Posts\",\n          \"Basic Courses and Exercises\"\n        ]\n      }\n    }\n  },\n  methods: {\n    getImage(type) {\n      switch (type) {\n        case \"education\":\n          return require(\"../assets/img/blogimages/education.png\");\n        case \"pills\":\n          return require(\"../assets/img/blogimages/pills.png\");\n        case \"projects\":\n          return require(\"../assets/img/blogimages/projects.png\");\n        default:\n          return require(\"../assets/img/blogimages/research.jpg\");\n      }\n    }\n  }\n}\n</script>\n<style lang=\"scss\" scoped>\n.center {\n  text-align: center;\n}\n.headline {\n  text-transform: uppercase;\n  margin: 4rem auto;\n  font-size: 4rem;\n}\nimg {\n  display: block;\n  margin: 0 auto;\n  width: 150px;\n}\n\nh2 {\n  color: #11100e;\n  text-transform: capitalize;\n  margin-bottom: 2rem;\n  font-family:  sans-serif;\n  font-weight: 100;\n}\n\nh3 {\n  //color: #0da766;\n  color: #27dc7e;\n  margin-bottom: 0;\n  cursor: pointer;\n  font-family:  Helvetica Neue, sans-serif;\n  &:hover {\n    text-decoration: underline;\n  }\n  .subtitle {\n    color: grey;\n    font-size: .98rem;\n    float: right;\n    font-weight: normal;\n  }\n}\n\nh5 {\n  //color: #0da766;\n  color: #27dc7e;\n  margin-bottom: 0;\n  cursor: pointer;\n  font-family:  Helvetica Neue, sans-serif;\n  &:hover {\n    text-decoration: underline;\n  }\n  .subtitle {\n    color: grey;\n    font-size: .98rem;\n    float: right;\n    font-weight: normal;\n  }\n}\n\np {\n  color: #11100e;\n  margin-top: .4rem;\n  font-family:  Helvetica Neue, sans-serif;\n}\n\n.sections {\n  max-width: 40vw;\n  margin: 0 auto;\n  margin-top: 4rem;\n}\n\n.section {\n  margin-bottom: 3rem;\n}\n\n.group {\n  margin-bottom: 4rem;\n}\n\n\n</style>\n"],"sourceRoot":"src/views"}]}