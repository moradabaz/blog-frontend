//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport axios from \"axios\";\nexport default {\n  name: \"Form\",\n  data: function data() {\n    return {\n      texto: \"\",\n      samples: [],\n      select_serie: '',\n      selected: 0,\n      title: \"Proximity Forest using DTW\",\n      accuracy: '',\n      prediction_serie: '',\n      samples_loaded: false,\n      model_created: false,\n      form: {\n        select_classifiers: 'pforest',\n        n_trees: '',\n        candidates: '',\n        neighbours: '',\n        window_size: '',\n        v_value: '',\n        prediction_serie: '',\n        dataset: ''\n      },\n      classifers: [{\n        values: \"pforest\",\n        text: \"Proximity Forest DTW\"\n      }, {\n        value: \"knnlb\",\n        text: \"KNN LbEnhanced\"\n      }],\n      datasets: [{\n        values: \"BirdChicken\",\n        text: \"Bird Chicken\",\n        serie_size: 512,\n        num_series: 2\n      }, {\n        values: \"Chinatown\",\n        text: \"Chinatown\",\n        serie_size: 24,\n        num_series: 2\n      }, //{ values: \"ERing\", text: \"ERing\", serie_size: 65, num_series: 6 },\n      {\n        values: \"FacesUCR\",\n        text: \"Faces UCR\",\n        serie_size: 131,\n        num_series: 14\n      }, {\n        values: \"ItalyPowerDemand\",\n        text: \"Italy Power Demand\",\n        serie_size: 24,\n        num_series: 2\n      }, {\n        values: \"Plane\",\n        text: \"Plane\",\n        serie_size: 144,\n        num_series: 7\n      }, {\n        values: \"SonyAIBORobotSurface\",\n        text: \"SonyAIBORobotSurface\",\n        serie_size: 70,\n        num_series: 2\n      }]\n    };\n  },\n  methods: {\n    onChange: function onChange(event) {\n      if (this.form.select_classifiers === \"pforest\") {\n        this.form.select_classifiers = \"knnlb\";\n        this.title = \"K Nearest Neighbours using enhanced Lower Bounds\";\n      } else {\n        this.form.select_classifiers = \"pforest\";\n        this.title = \"Proximity Forest using DTW\";\n      }\n    },\n    isSelected: function isSelected(i) {\n      return i === this.selected;\n    },\n    submitCreation: function submitCreation() {\n      if (this.form.select_classifiers === 'pforest') {\n        console.log(\"trees: \" + this.form.n_trees);\n        console.log(\"candidates: \" + this.form.candidates);\n        console.log(\"classifier: \" + this.form.select_classifiers);\n        console.log(\"dataset   : \" + this.datasets[this.selected].values);\n      } else {\n        console.log(\"neighbours: \" + this.form.neighbours);\n        console.log(\"window    : \" + this.form.window_size);\n        console.log(\"threshold : \" + this.form.v_value);\n        console.log(\"classifier: \" + this.form.select_classifiers);\n        console.log(\"dataset   : \" + this.datasets[this.selected].values);\n      }\n    },\n    loadSamples: function loadSamples(index) {\n      var _this = this;\n\n      if (this.selected !== index) {\n        this.model_created = false;\n        this.accuracy = '';\n        this.samples_loaded = true;\n        this.selected = index;\n        var path = 'http://localhost:8000/api/v1.0/load-sample/';\n        var params = {\n          'dataset': this.datasets[this.selected].values\n        };\n        axios.post(path, params).then(function (response) {\n          _this.samples = [];\n\n          for (var i = 0; i < response.data['series_data'].length; i++) {\n            _this.samples.push({\n              value: response.data['series_data'][i]['serie'].toString(),\n              text: response.data['series_data'][i]['serie'].toString()\n            });\n\n            console.log(_this.samples);\n          }\n\n          console.log(_this.samples);\n        });\n      }\n    },\n    submitPrediction: function submitPrediction() {\n      var _this2 = this;\n\n      if (this.form.prediction_serie === '') {\n        this.prediction_serie = '';\n        return;\n      }\n\n      if (!this.model_created) {\n        this.prediction_serie = 'You create a model first';\n        return;\n      }\n\n      var path = 'http://localhost:8000/api/v1.0/predict-serie/';\n      console.log(this.form);\n      this.form.dataset = this.datasets[this.selected].values; //this.form.prediction_serie = this.form.prediction_serie.toString()\n\n      console.log(this.form.prediction_serie);\n      JSON.stringify(this.form);\n      axios.post(path, this.form).then(function (response) {\n        console.log(\"Label: \" + response.data['predicted_class']);\n        _this2.prediction_serie = \"Your serie belongs to the class number \" + response.data['predicted_class'];\n      });\n    },\n    onSubmit: function onSubmit(evt) {\n      var _this3 = this;\n\n      evt.preventDefault();\n      var path = 'http://localhost:8000/api/v1.0/create-model/';\n      console.log(this.form);\n      this.form.dataset = this.datasets[this.selected].values;\n      JSON.stringify(this.form);\n\n      if (!this.checkFiels(this.form.select_classifiers)) {\n        this.accuracy = 'Some fields are not correct, please check';\n        return;\n      }\n\n      axios.post(path, this.form).then(function (response) {\n        console.log(\"Accuracy: \" + response.data['accuracy']);\n        _this3.accuracy = 'Your model has an accuracy of ' + response.data['accuracy'] + ' %';\n        _this3.model_created = true;\n        swal(\"Model created successfully\", \"\", \"success\");\n      }).catch(function (error) {\n        swal(\"Model not created\", \"\", \"error\");\n      });\n\n      if (!this.samples_loaded) {\n        this.loadSamples(this.selected);\n        this.samples_loaded = true;\n      }\n    },\n    checkFiels: function checkFiels(classifier) {\n      var check = true;\n\n      if (classifier === 'pforest') {\n        if (this.form.n_trees === '' || parseInt(this.form.n_trees) <= 0) {\n          check = false;\n        } else {\n          if (this.form.candidates === '' || parseInt(this.form.candidates) <= 0) {\n            check = false;\n          }\n        }\n      } else {\n        if (this.form.neighbours === '' || parseInt(this.form.neighbours) <= 0) {\n          check = false;\n        } else {\n          if (this.form.window_size === '' || parseFloat(this.form.window_size) <= 0) {\n            check = false;\n          } else {\n            if (this.form.v_value === '' || parseFloat(this.form.v_value) <= 0) {\n              check = false;\n            }\n          }\n        }\n      }\n\n      return check;\n    },\n    selectSerie: function selectSerie() {\n      this.form.prediction_serie = this.select_serie;\n    }\n  },\n  computed: {\n    ispforest: function ispforest() {\n      return this.form.select_classifiers === \"pforest\";\n    }\n  }\n};",{"version":3,"sources":["ModelCreationForm.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmJA,OAAA,KAAA,MAAA,OAAA;AAEA,eAAA;AACA,EAAA,IAAA,EAAA,MADA;AAEA,EAAA,IAFA,kBAEA;AACA,WAAA;AACA,MAAA,KAAA,EAAA,EADA;AAEA,MAAA,OAAA,EAAA,EAFA;AAGA,MAAA,YAAA,EAAA,EAHA;AAIA,MAAA,QAAA,EAAA,CAJA;AAKA,MAAA,KAAA,EAAA,4BALA;AAMA,MAAA,QAAA,EAAA,EANA;AAOA,MAAA,gBAAA,EAAA,EAPA;AAQA,MAAA,cAAA,EAAA,KARA;AASA,MAAA,aAAA,EAAA,KATA;AAUA,MAAA,IAAA,EAAA;AACA,QAAA,kBAAA,EAAA,SADA;AAEA,QAAA,OAAA,EAAA,EAFA;AAGA,QAAA,UAAA,EAAA,EAHA;AAIA,QAAA,UAAA,EAAA,EAJA;AAKA,QAAA,WAAA,EAAA,EALA;AAMA,QAAA,OAAA,EAAA,EANA;AAOA,QAAA,gBAAA,EAAA,EAPA;AAQA,QAAA,OAAA,EAAA;AARA,OAVA;AAoBA,MAAA,UAAA,EAAA,CACA;AAAA,QAAA,MAAA,EAAA,SAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,KAAA,EAAA,OAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OAFA,CApBA;AAwBA,MAAA,QAAA,EAAA,CACA;AAAA,QAAA,MAAA,EAAA,aAAA;AAAA,QAAA,IAAA,EAAA,cAAA;AAAA,QAAA,UAAA,EAAA,GAAA;AAAA,QAAA,UAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,MAAA,EAAA,WAAA;AAAA,QAAA,IAAA,EAAA,WAAA;AAAA,QAAA,UAAA,EAAA,EAAA;AAAA,QAAA,UAAA,EAAA;AAAA,OAFA,EAGA;AACA;AAAA,QAAA,MAAA,EAAA